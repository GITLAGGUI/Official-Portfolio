# Server-only assistant configuration. Never use a VITE_ prefix for a secret.
OLLAMA_API_KEY=
OLLAMA_MODEL=

# Production shared visit storage. Local dev/preview uses .local/visits.json.
# Configure these server-side in Vercel. Neither value is sent to the browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The Vercel Upstash integration also injects KV_REST_API_URL / KV_REST_API_TOKEN.
